{
  "name": "@nusajs/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Private Node.js CLI infrastructure for NusaJS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "nusajs": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.type-tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nusajs/compiler": "workspace:*",
    "vite": "7.3.6"
  }
}
