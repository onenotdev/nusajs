{
  "name": "@nusajs/renderer-preact",
  "version": "0.0.0",
  "private": true,
  "description": "Official minimal Preact SSR renderer for NusaJS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build --force tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.type-tests.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nusajs/core": "workspace:*",
    "preact": "10.29.8",
    "preact-render-to-string": "6.7.0"
  }
}
