{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "types": ["node"],
    "lib": ["ES2023"],
    "outDir": ".tsbuild"
  },
  "include": ["vitest.config.ts", "packages/**/*.ts"]
}
